#!/bin/bash
# Development script for proton_drive_gts.py
# Usage: ./dev [all|test|linter|lint|install]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

check_deps() {
    python3 -c "import pytest" 2>/dev/null || return 1
    python3 -c "import pylint" 2>/dev/null || return 1
    return 0
}

install_deps() {
    echo "=== Installing Dependencies ==="
    python3 -m pip install --break-system-packages -r requirements.txt
}

ensure_deps() {
    if ! check_deps; then
        install_deps
    fi
}

run_tests() {
    ensure_deps
    echo "=== Running Tests ==="
    QT_QPA_PLATFORM=offscreen python3 -m pytest test_proton_drive_gts.py test_ui_flow.py test_proton_drive_gts_ui.py test_ui_canary.py -v
}

run_linter() {
    ensure_deps
    echo "=== Running Linter (pylint) ==="
    python3 -m pylint proton_drive_gts.py test_proton_drive_gts.py
    QT_QPA_PLATFORM=offscreen python3 -m pylint ui_flow.py proton_drive_gts_ui.py test_ui_flow.py test_proton_drive_gts_ui.py
}

case "${1:-}" in
    all)
        run_tests
        run_linter
        ;;
    test)
        run_tests
        ;;
    linter|lint)
        run_linter
        ;;
    install)
        install_deps
        ;;
    *)
        echo "Usage: $0 [all|test|linter|lint|install]"
        echo "  all      - Run tests and linter"
        echo "  test     - Run tests only"
        echo "  linter   - Run pylint only"
        echo "  lint     - Alias for linter"
        echo "  install  - Install dependencies"
        exit 1
        ;;
esac
